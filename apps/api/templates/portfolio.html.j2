{% extends "base.html.j2" %}
{% block title %}Assurance portfolio · Vendor Red-Team Passport{% endblock %}
{% block content %}
  <div class="top"><h1>Continuous assurance queue</h1><span class="meta">Urgent items first · tenant scoped</span></div>
  <p class="small"><a href="/">← Dashboard</a> · This is an operational queue, not an executive scorecard.</p>
  <div class="card" style="margin-top:14px;">
    {% if items %}
    <table>
      <thead><tr><th>State</th><th>Vendor / system</th><th>Risk</th><th>Latest gate</th><th>Next reassessment</th></tr></thead>
      <tbody>
      {% for item in items %}
        <tr>
          <td><span class="pill {{ 'ok' if item.state == 'healthy' else ('warn' if item.state in ['due','review_required'] else 'bad') }}">{{ item.state }}</span></td>
          <td><strong>{{ item.vendor_name }}</strong><div class="small">{{ item.system_name }}</div><div class="small"><code>{{ item.assessment_id }}</code></div></td>
          <td>{{ item.risk_tier }}</td>
          <td>{{ item.last_evaluation.outcome or 'not evaluated' }}</td>
          <td>{{ item.next_run_at or 'not scheduled' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="small">No assessments are currently in this tenant's assurance queue.</p>{% endif %}
  </div>
{% endblock %}
