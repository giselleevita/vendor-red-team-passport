# ══════════════════════════════════════════════════
# Vendor Red Team Passport — Railway Environment Variables
# Copy these into Railway → Project → Variables
# ══════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────
# LLM provider key (Featherless.ai — serverless open-weight models)
FEATHERLESS_API_KEY=your-featherless-api-key

# Bearer JWT auth
AUTH_ENABLED=true
AUTH_JWT_HS256_SECRET=CHANGE-ME-use-openssl-rand-hex-32
RBAC_ENABLED=true

# ── PATHS (Railway ephemeral filesystem) ────────────────
# Reports and run artifacts — use a Railway Volume or S3 for persistence
VENDOR_RTP_REPORTS_DIR=/app/reports

# ── LLM / EVAL CONFIG ───────────────────────────────
# Default model for evaluations
DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
REQUEST_TIMEOUT_SECONDS=45

# ── OPTIONAL ──────────────────────────────────────────
VENDOR_RTP_MANIFEST_HMAC_KEY=
RUN_EXECUTOR_MODE=external

# Railway injects PORT automatically — do not set manually
# PORT=8000
