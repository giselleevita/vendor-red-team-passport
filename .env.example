# ============================================================================
# SECTION 1: AUTHENTICATION & SECURITY (CRITICAL - MUST SET)
# ============================================================================

# JWT Secret for signing Bearer tokens (HS256)
# CRITICAL: Must be at least 32 characters of random data
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
AUTH_JWT_HS256_SECRET=

# JWT Issuer claim (must match token issuer)
AUTH_JWT_ISSUER=vendor-rtp-local

# JWT Audience claim (must match token audience)
AUTH_JWT_AUDIENCE=vendor-rtp-api

# JWT token expiration/validation settings
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
AUTH_DEFAULT_TENANT_ID=default
AUTH_LEGACY_DEFAULT_TENANT_ID=legacy

# Enable authentication (MUST be true in production)
AUTH_ENABLED=true

# Enable role-based access control
RBAC_ENABLED=true

# ============================================================================
# SECTION 2: FEATHERLESS API (REQUIRED FOR LLM EVALUATION)
# ============================================================================

# Featherless API Key
# Get from: https://featherless.ai/api-keys
# CRITICAL: Keep secret, never commit to git
FEATHERLESS_API_KEY=

# Featherless API base URL
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Default model for evaluations
DEFAULT_MODEL=moonshotai/Kimi-K2-Instruct

# LLM API request configuration
REQUEST_TIMEOUT_SECONDS=45
REQUEST_MIN_INTERVAL_SECONDS=1.0
REQUEST_MAX_RETRIES=6
REQUEST_RETRY_BACKOFF_BASE_SECONDS=1.0
REQUEST_RETRY_MAX_SLEEP_SECONDS=20.0

# Optional semantic judge. Disabled by default; deterministic ambiguity fails closed.
# When enabled, prompts and raw model responses are transmitted ephemerally to this
# separately configured OpenAI-compatible endpoint and are not persisted by this tool.
JUDGE_ENABLED=false
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=20
JUDGE_CONFIDENCE_THRESHOLD=0.80

# ============================================================================
# SECTION 3: JOB EXECUTION & STORAGE
# ============================================================================

# Job executor mode: "inline" (testing) or "external" (production)
RUN_EXECUTOR_MODE=inline

# Job execution retry configuration
RUN_JOB_MAX_ATTEMPTS=3
RUN_JOB_BACKOFF_BASE_SECONDS=1.0
RUN_JOB_BACKOFF_MAX_SECONDS=30.0

# Job store backend: "file" (dev) or "sql" (production)
JOB_STORE_BACKEND=file

# Database connection (required if JOB_STORE_BACKEND=sql)
# Examples:
#   sqlite:///./jobs.db
#   postgresql://user:password@localhost:5432/vendor_rtp
JOB_STORE_DSN=

# ============================================================================
# SECTION 4: AUDIT & COMPLIANCE
# ============================================================================

# HMAC key for detecting modification of signed entries. The v0.2 format does
# not detect deletion or reordering; see docs/transparency.md.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Optional but recommended for production
VENDOR_RTP_MANIFEST_HMAC_KEY=
